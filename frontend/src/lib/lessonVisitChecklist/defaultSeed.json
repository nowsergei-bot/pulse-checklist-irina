          "allowMultiple": false,
          "hint": ""
        },
        {
          "id": "q_27",
          "code": "9.3",
          "text": "Психологический климат урока",
          "type": "radio",
          "required": true,
          "options": [
            "комфортная атмосфера урока (позитивный настрой на работу у обучающихся)",
