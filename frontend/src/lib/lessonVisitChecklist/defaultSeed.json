          "allowMultiple": false,
          "hint": ""
        },
        {
          "id": "q_24",
          "code": "8.2",
          "text": "Качество и уместность наглядных материалов (в т.ч. материал отражен на доске, в схемах и т.п.)",
          "type": "radio",
          "required": true,
          "options": [
            "высокое, уместны",
            "среднее, не всегда уместны",
            "низкое, неуместны",
            "не использовались, что снизило качество урока",
            "не использовались ввиду специфики урока"
          ],
          "allowMultiple": false,
          "hint": ""
        }
      ]
    },
