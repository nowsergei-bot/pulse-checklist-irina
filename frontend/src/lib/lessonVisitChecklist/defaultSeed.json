      "id": "sec_7",
      "code": "8",
      "title": "Инструменты",
      "questions": [
        {
          "id": "q_23",
          "code": "8.1",
          "text": "Цифровые инструменты",
          "type": "radio",
          "required": true,
          "options": [
            "используются сообразно типу урока",
            "используются нецелесообразно",
            "не используются"
