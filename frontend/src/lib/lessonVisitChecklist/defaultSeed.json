  "sections": [
    {
      "id": "sec_0",
      "code": "1",
      "title": "Организационный блок",
      "questions": [
        {
          "id": "q_1",
          "code": "1.1",
          "text": "Готовность к уроку (классная доска оформлена, раздаточный материал готов, рабочее место учителя подготовлено и т.д.)",
          "type": "radio",
          "required": true,
          "options": [
            "готов",
            "частично",
            "не готов"
          ],
          "allowMultiple": false,
          "hint": ""
        },
        {
          "id": "q_2",
          "code": "1.2",
          "text": "Санитарное состояние кабинета",
          "type": "radio",
          "required": true,
          "options": [
            "удовлетворительное",
            "неудовлетворительное"
          ],
          "allowMultiple": false,
          "hint": ""
        }
      ]
    },
    {
      "id": "sec_1",
      "code": "2",
      "title": "Целеполагание",
      "questions": [
        {
          "id": "q_3",
          "code": "2.1",
          "text": "Цели урока сформулированы:",
          "type": "radio",
          "required": true,
          "options": [
            "учителем",
            "совместно с обучающимися",
            "обучающимися",
            "не сформулированы"
          ],
          "allowMultiple": false,
          "hint": ""
        },
        {
          "id": "q_4",
          "code": "2.2",
          "text": "Цели урока соответствуют теме урока",
          "type": "radio",
          "required": true,
          "options": [
            "да",
            "нет"
          ],
          "allowMultiple": false,
          "hint": ""
        },
        {
          "id": "q_5",
          "code": "2.3",
          "text": "Цели урока понятны обучающимся",
          "type": "radio",
          "required": true,
          "options": [
            "да",
            "нет"
          ],
          "allowMultiple": false,
          "hint": ""
        }
      ]
    },
    {
      "id": "sec_2",
      "code": "3",
      "title": "Методическая и психолого-педагогическая грамотность",
      "questions": [
        {
          "id": "q_6",
          "code": "3.1",
          "text": "Содержание учебного материала соответствует поставленным целям урока, а также учебной программе",
          "type": "radio",
          "required": true,
          "options": [
            "да",
            "нет"
          ],
          "allowMultiple": false,
          "hint": ""
        },
        {
          "id": "q_7",
          "code": "3.2",
          "text": "Структура урока данного типа",
          "type": "radio",
          "required": true,
          "options": [
            "четкая",
            "структура не прослеживается"
          ],
          "allowMultiple": false,
          "hint": ""
        },
        {
          "id": "q_8",
          "code": "3.3",
          "text": "Темп урока соответствует возрасту и индивидуально-психологическим особенностям обучающихся",
          "type": "radio",
          "required": true,
          "options": [
            "да",
            "нет"
          ],
          "allowMultiple": false,
          "hint": ""
        },
        {
          "id": "q_9",
          "code": "3.4",
          "text": "На уроке чередуются формы работы и виды активности (динамика урока)",
          "type": "radio",
          "required": true,
          "options": [
            "да",
            "нет"
          ],
          "allowMultiple": false,
          "hint": ""
        },
        {
          "id": "q_10",
          "code": "3.5",
          "text": "Межпредметные связи",
          "type": "radio",
          "required": true,
          "options": [
            "присутствуют",
            "отсутствуют"
          ],
          "allowMultiple": false,
          "hint": ""
        },
        {
          "id": "q_11",
          "code": "3.6",
          "text": "Задания дифференцированы в соответствии с уровнями обучающихся.",
          "type": "radio",
          "required": true,
          "options": [
            "дифференцированность заданий предусмотрена",
            "фронтальные задания \"одно для всех\""
          ],
          "allowMultiple": false,
          "hint": ""
        },
        {
          "id": "q_12",
          "code": "3.7",
          "text": "Содержание объясняется через (какие методы)",
          "type": "checkbox",
          "required": true,
          "options": [
            "создание проблемной ситуации (противоречия)",
            "самостоятельную работу обучающихся (в т.ч. В группе)",
            "домашнее задание (в т.ч. \"перевёрнутый класс\")",
            "самостоятельная работа с учебником",
            "учебная лекция",
            "пример педагога / объяснение через обучающихся, имеющих образцово-показательную технику (на физической культуре)",
            "другое"
          ],
          "allowMultiple": true,
          "hint": ""
        },
        {
          "id": "q_13",
          "code": "3.8",
          "text": "Информация о домашнем задании",
          "type": "checkbox",
          "required": true,
          "options": [
            "дается инструктаж по выполнению (возможно по ходу урока)",
            "задание дано в достаточном объеме",
            "задание соответствует содержанию и целям урока",
            "домашнее задание не соответствует содержанию и целям урока",
            "домашнее задание избыточно",
            "домашнее задание не задано (в соответствии с типом урока)"
          ],
          "allowMultiple": true,
          "hint": ""
        }
      ]
    },
    {
      "id": "sec_3",
      "code": "4",
      "title": "Корректность и глубина понимания предметного содержания",
      "questions": [
        {
          "id": "q_14",
          "code": "4.1",
          "text": "Учебный материал",
          "type": "radio",
          "required": true,
          "options": [
            "доступен и понятен обучающимся, соответствует их индивидуальным и возрастным особенностям",
            "не соответствует уровню обучающихся, сложно воспринимается"
          ],
          "allowMultiple": false,
          "hint": ""
        },
        {
          "id": "q_15",
          "code": "4.2",
          "text": "Владение учителем учебным материалом предмета",
          "type": "radio",
          "required": true,
          "options": [
            "обладает глубокими знаниями по теме урока",
            "достаточный уровень",
            "требует улучшения"
          ],
          "allowMultiple": false,
          "hint": ""
        }
      ]
    },
    {
      "id": "sec_4",
      "code": "5",
      "title": "Результативность",
      "questions": [
        {
          "id": "q_16",
          "code": "5.1",
          "text": "Обратная связь учителя обучающимся",
          "type": "checkbox",
          "required": true,
          "options": [
            "на каждом этапе урока",
            "в конце урока",
            "обратная связь конкретная, развивающая",
            "обратная связь дается формально",
            "обратная связь не была организована"
          ],
          "allowMultiple": true,
          "hint": ""
        },
        {
          "id": "q_17",
          "code": "5.2",
          "text": "Рефлексия на уроке",
          "type": "radio",
          "required": true,
          "options": [
            "присутствует",
            "отсутствует"
          ],
          "allowMultiple": false,
          "hint": ""
        },
        {
          "id": "q_18",
          "code": "5.3",
          "text": "Формы контроля усвоения содержания",
          "type": "checkbox",
          "required": true,
          "options": [
            "фронтальный опрос",
            "индивидуальный опрос",
            "дидактическая игра",
            "тестирование",
            "решение задач, упражнений"
          ],
          "allowMultiple": true,
          "hint": ""
        },
        {
          "id": "q_19",
          "code": "5.4",
          "text": "Виды оценивания на уроке",
          "type": "checkbox",
          "required": true,
          "options": [
            "самооценка",
            "взаимооценка",
            "экспертная оценка учителем",
            "отсутствует"
          ],
          "allowMultiple": true,
          "hint": ""
        }
      ]
    },
    {
      "id": "sec_5",
      "code": "6",
      "title": "Мотивация и вовлеченность",
      "questions": [
        {
          "id": "q_20",
          "code": "6.1",
          "text": "Привлечение внимания и пробуждение интереса к теме через",
          "type": "checkbox",
          "required": true,
          "options": [
            "Учёт индивидуальных, возрастных и психологических особенностей обучающихся",
            "эмоциональное вовлечение",
            "Вовлечение в разные виды практической деятельности (эвристической, исследовательской, творческой и др.)",
            "Разнообразие приёмов",
            "Смену видов деятельности в соответствии с динамикой работоспособности обучающихся",
            "Постановку актуальной для обучающихся проблемы для рассмотрения и решения в ходе урока",
            "Обращение к имеющемуся личностно значимому и социально значимому опыту обучающихся",
            "Поддержку вопросов обучающихся по теме занятия",
            "Организацию и сопровождение взаимодействия и учебного сотрудничества обучающихся (работа в парах, группах, организация процесса общего обсуждения)",
            "Другое (вписать свои варианты)",
            "Способы мотивации на уроке не применялись"
          ],
          "allowMultiple": true,
          "hint": ""
        },
        {
          "id": "q_21",
          "code": "6.2",
          "text": "Вовлечённость учащихся в процесс урока",
          "type": "radio",
          "required": true,
          "options": [
            "100% обучающихся активно вовлечены в урок (через парную, групповую/командную формы работы, включённость в общее обсуждение)",
            "Вовлечены большинство обучающихся (не менее ¾ класса), но некоторые остаются пассивными",
            "Вовлечена только часть класса (сильные ученики, лидеры), большая часть остаётся пассивной",
            "Массовое отсутствие вовлечённости, пассивность класса в целом, имеются эпизоды деструктивного поведения"
          ],
          "allowMultiple": false,
          "hint": ""
        }
      ]
    },
    {
      "id": "sec_6",
      "code": "7",
      "title": "Воспитательный потенциал урока",
      "questions": [
        {
          "id": "q_22",
          "code": "7.1",
          "text": "На уроке используются методы и приемы, обеспечивающие формирование ценностей Гимназии и традиционных российских духовно-нравственных ценностей с учетом возрастных особенностей обучающихся",
          "type": "radio",
          "required": true,
          "options": [
            "да",
            "нет"
          ],
          "allowMultiple": false,
          "hint": ""
        }
      ]
    },
