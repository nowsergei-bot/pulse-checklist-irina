            "да",
            "нет"
          ],
          "allowMultiple": false,
          "hint": ""
        },
        {
          "id": "q_5",
          "code": "2.3",
          "text": "Цели урока понятны обучающимся",
          "type": "radio",
          "required": true,
          "options": [
            "да",
            "нет"
          ],
          "allowMultiple": false,
          "hint": ""
        }
