          "required": true,
          "options": [
            "да",
            "нет"
          ],
          "allowMultiple": false,
          "hint": ""
        },
        {
          "id": "q_10",
          "code": "3.5",
          "text": "Межпредметные связи",
          "type": "radio",
          "required": true,
          "options": [
            "присутствуют",
            "отсутствуют"
          ],
          "allowMultiple": false,
          "hint": ""
