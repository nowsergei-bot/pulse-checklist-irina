{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:pulse:assessment-response:v3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "request_id",
    "checklist_id",
    "revision",
    "source_hash",
    "rubric_version",
    "rubric_hash",
    "contract_version",
    "prompt_version",
    "rules_hash",
    "criteria",
    "room_adjustment"
  ],
  "properties": {
    "request_id": {
      "type": "string",
      "minLength": 1
    },
    "checklist_id": {
      "type": "string",
      "minLength": 1
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "source_hash": {
      "type": "string",
      "minLength": 1
    },
    "rubric_version": {
      "type": "string",
      "minLength": 1
    },
    "rubric_hash": {
      "type": "string",
      "minLength": 1
    },
    "contract_version": {
      "type": "string",
      "minLength": 1
    },
    "prompt_version": {
      "type": "string",
      "minLength": 1
    },
    "rules_hash": {
      "type": "string",
      "minLength": 1
    },
    "criteria": {
      "type": "array",
      "minItems": 30,
      "maxItems": 30,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "status",
          "score",
          "max_score",
          "rule_id",
          "reason",
          "evidence",
          "features"
        ],
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "1.1",
              "1.2",
              "2.1",
              "2.2",
              "2.3",
              "3.1",
              "3.2",
              "3.3",
              "3.4",
              "3.5",
              "3.6",
              "3.7",
              "3.8",
              "4.1",
              "4.2",
              "5.1",
              "5.2",
              "5.3",
              "5.4",
              "6.1",
              "6.2",
              "7.1",
              "8.1",
              "8.2",
              "9.1",
              "9.2",
              "9.3",
              "10.1",
              "10.2",
              "10.3"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "scored",
              "descriptive",
              "not_applicable",
              "missing_answer",
              "insufficient_evidence",
              "contradiction"
            ]
          },
          "score": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0,
            "maximum": 10
          },
          "max_score": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1,
            "maximum": 10
          },
          "rule_id": {
            "type": "string"
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "field",
                "quote"
              ],
              "properties": {
                "field": {
                  "type": "string",
                  "description": "JSON Pointer к строке исходного ответа, метки выбранного варианта или комментария"
                },
                "quote": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Точная подстрока исходного текста без исправлений и пересказа"
                }
              }
            }
          },
          "features": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "value",
                "evidence"
              ],
              "properties": {
                "value": {
                  "type": [
                    "boolean",
                    "string",
                    "null"
                  ]
                },
                "evidence": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "field",
                      "quote"
                    ],
                    "properties": {
                      "field": {
                        "type": "string",
                        "description": "JSON Pointer к строке исходного ответа, метки выбранного варианта или комментария"
                      },
                      "quote": {
                        "type": "string",
                        "minLength": 1,
                        "description": "Точная подстрока исходного текста без исправлений и пересказа"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "room_adjustment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "problem_reference",
        "conditions"
      ],
      "properties": {
        "problem_reference": {
          "type": [
            "string",
            "null"
          ]
        },
        "conditions": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "value",
              "evidence"
            ],
            "properties": {
              "id": {
                "type": "integer",
                "enum": [
                  1,
                  2,
                  3,
                  4
                ]
              },
              "value": {
                "type": [
                  "boolean",
                  "null"
                ]
              },
              "evidence": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "field",
                    "quote"
                  ],
                  "properties": {
                    "field": {
                      "type": "string",
                      "description": "JSON Pointer к строке исходного ответа, метки выбранного варианта или комментария"
                    },
                    "quote": {
                      "type": "string",
                      "minLength": 1,
                      "description": "Точная подстрока исходного текста без исправлений и пересказа"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
