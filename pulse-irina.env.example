# Параметры подключения, не секреты и не серверный .env
PULSE_PRODUCTION_URL=https://pulse.primakov-school.ru
PULSE_STAGING_URL=https://monitoring-test.primakov-school.ru
PULSE_REPOSITORY_URL=https://github.com/nowsergei-bot/pulse-checklist-irina.git
PULSE_TARGET_BRANCH=codex/checklist-irina
